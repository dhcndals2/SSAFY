#include <iostream>
#include <string>
#include <vector>
#include <cmath>
#include <algorithm>

using namespace std;

int main() {
	string s = "MINCODING";

	int n;
	char a[10] = {};
	bool b[10] = {  };
	cin >> n;
	for (int i = 0; i < n; i++)
	{
		cin >> a[i];
	}
	int c = s.length();
	for (int i = 0; i < n; i++)
	{
		for (int j = 0; j < c; j++)
		{
			if (a[i] == s[j])
			{
				b[i] = true;
			}
		}
	}
	for (int i = 0; i < n; i++)
	{
		if (b[i])
		{
			cout << "O";
		}
		else
			cout << "X";
	}
}
