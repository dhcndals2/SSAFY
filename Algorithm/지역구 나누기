#include <iostream>
#include <vector>
#include <queue>
#include <cmath>

using namespace std;

int t, n;
int map[9][9];
int power[9];
int visited[9];
int path[9]; // 각 도시가 속한 그룹 (0 또는 1)
int min_val;

void init() {
	min_val = 21e8;
}

// 입력 처리 함수
void input() {
	cin >> n;
	for (int i = 0; i < n; i++) {
		power[i] = 0;
		visited[i] = 0;
		path[i] = -1;
		for (int j = 0; j < n; j++) {
			map[i][j] = 0;
		}
	}

	for (int i = 0; i < n; i++) {
		for (int j = 0; j < n; j++) {
			cin >> map[i][j];
		}
	}
	for (int i = 0; i < n; i++) {
		cin >> power[i];
	}
}

// 두 그룹의 연결성을 확인하고 인구 차이를 계산하는 함수
void solve() {
	int start_index[2] = { -1, -1 };
	int group_count[2] = { 0, 0 };

	// 1. 각 그룹의 도시 수와 BFS 시작 지점 찾기
	for (int i = 0; i < n; i++) {
		int group = path[i];
		group_count[group]++;
		if (start_index[group] == -1) {
			start_index[group] = i;
		}
	}

	// CRITICAL FIX: 한쪽 그룹이라도 비어있으면 유효한 분할이 아니므로 즉시 종료
	if (group_count[0] == 0 || group_count[1] == 0) {
		return;
	}

	// visited 배열 초기화
	for (int i = 0; i < n; i++) visited[i] = 0;

	// 2. 각 그룹에 대해 BFS를 수행하여 연결성 확인
	for (int group = 0; group < 2; group++) {
		if (group_count[group] > 0) {
			queue<int> q;
			q.push(start_index[group]);
			visited[start_index[group]] = 1;
			int bfs_count = 1;

			while (!q.empty()) {
				int current = q.front();
				q.pop();

				for (int i = 0; i < n; i++) {
					// 연결되지 않았거나, 같은 그룹이 아니거나, 이미 방문했다면 건너뜀
					if (map[current][i] == 0 || path[i] != group || visited[i]) {
						continue;
					}
					visited[i] = 1;
					q.push(i);
					bfs_count++;
				}
			}

			// 그룹 내 총 도시 수와 BFS로 방문한 도시 수가 다르면 연결되지 않은 것
			if (bfs_count != group_count[group]) {
				return;
			}
		}
	}

	// 두 그룹 모두 연결되었다면 인구 수 차이 계산 및 최솟값 갱신
	int power_sum[2] = { 0, 0 };
	for (int i = 0; i < n; i++) {
		power_sum[path[i]] += power[i];
	}
	min_val = min(min_val, abs(power_sum[0] - power_sum[1]));
}

// DFS로 모든 그룹 조합을 만드는 함수
void dfs(int lev) {
	if (lev == n) {
		solve();
		return;
	}

	path[lev] = 0;
	dfs(lev + 1);

	path[lev] = 1;
	dfs(lev + 1);
}

int main() {

	cin >> t;
	for (int test = 1; test <= t; test++) {
		init();
		input();
		dfs(0);
		cout << "#" << test << " " << min_val << endl;
	}
	return 0;
}
