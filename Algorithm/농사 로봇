#include <iostream>
#include <cmath>
#include <algorithm>
#include <queue>
#include <cstring>

using namespace std;

int dy[] = { -1,1,0,0 };
int dx[] = { 0,0,-1,1 };
int n,m;
int map[11][11];
int map_count[11][11];
int grow_map[11][11];
bool flag[11][11];

int dir_change[4][4] = {
	{3,0,2,1},
	{2,1,3,0},
	{0,2,1,3},
	{1,3,0,2}};//입력 방향,출력방향

struct Point
{
	int y, x;
	int dir;
};

Point st;

void input()
{
	cin >> n>>m;
	for (int i = 0; i < n; i++)
	{
		for (int j = 0; j <n; j++)
		{
			cin >> map[i][j];
		}
	}
}

void reset()
{
	for (int i = 0; i < 11; i++)
	{
		for (int j = 0; j < 11; j++)
		{
			map[i][j] = 0;
			map_count[i][j] = 1;
			grow_map[i][j] = 0;
			flag[i][j] = false; 

		}
	}
}

int main()
{

	int t;

	cin >> t;
	for(int test=0;test<t;test++)
	{
		reset();
		input();
		int max_val = 0;
	for (int i = 0; i < n; i++)
	{
		for (int j = 0; j < n; j++)//시작지점 찾기위한 순회
		{

			if (map[i][j] == 1)//산이면 시작안함
				continue;
			for(int k=0;k<4;k++){

				int count = 0;
				st.y = i;
				st.x = j;
				st.dir = k;

				for (int a = 0; a < 11; a++)
				{
					for (int b = 0; b < 11; b++)
					{
						map_count[a][b] = 1;//시작전 초기화
						grow_map[a][b] = 0;
						flag[a][b] = false;

					}
				}

				int copy_m = m;

				Point cp = st;

				while (copy_m--)
				{
					/* 오전 이동 불가할경우 작물심지않고 대기 또는 작물심기 또는 수확   */
					
					bool can_move = false;
					bool can_move2 = false;
					for (int c = 0; c < 4; c++)//4방향 미리 탐색한다
					{
						Point np;
						np.dir = dir_change[cp.dir][c];
						np.y = cp.y + dy[np.dir];
						np.x = cp.x + dx[np.dir];

						if (map[np.y][np.x] != 1 && grow_map[np.y][np.x] == 0)
						{//상하좌우,산인지, 작물있는지
							can_move = true;
							
						}
						if (map[np.y][np.x] != 1)
						{//상하좌우,산인지만 // 시작위치가 아예 산으로 둘러쌓인경우 판단
							can_move2 = true;
						}
					}
					if (!can_move2) {//시작위치가 아예 산인 경우 종료
						break;
					}
					
					//심기 빈농지+수확농지아님+움직일수있음
					if (grow_map[cp.y][cp.x] == 0&& flag[cp.y][cp.x] == false && can_move)//땅에 아무것도없을경우 심기
					{ 
						grow_map[cp.y][cp.x] = map_count[cp.y][cp.x] + 3;
						map_count[cp.y][cp.x]++;//한번 심어진 땅은 수확일+1
						flag[cp.y][cp.x] = true;//작물이 있음
					}
					//수확 성장완료상태+수확가능농지
					else if(grow_map[cp.y][cp.x] == 0 &&flag[cp.y][cp.x]==true)//심은적이있고 수확가능
					{
						count++; //수확카운트      
						flag[cp.y][cp.x] = false;//수확을 완료했으면 빈땅으로 변경
					}
					else if (grow_map[cp.y][cp.x] == 0 && !can_move)
					{
						//빈농지+산이나작물로 이동 불가능할때는 심지도않고 이동안함
						continue;
					}


					/*-------------- 오후이동--------------------  */
					for (int c = 0; c < 4; c++)
					{//4방향중 로봇 기준으로 오른 앞 왼 뒤 되는 것 먼저 이동
						Point np;
						np.dir = dir_change[cp.dir][c];
						np.y = cp.y + dy[np.dir];
						np.x = cp.x + dx[np.dir];
						//이동 가능조건 산아님, 심어진 농지아님
						if (map[np.y][np.x] == 1 || grow_map[np.y][np.x] != 0)
						{
							continue;
						}
						cp = np;
						break;//가능한곳 먼저 나오면 바로 종료
					}
					//날짜 변경 추가하기
					
					for (int c = 0; c < n; c++)
					{
						for (int d = 0; d < n; d++)
						{
							if (grow_map[c][d] != 0)
							{
								grow_map[c][d]--;
							}
						}
					}
				}
				//한 좌표 방향 끝
				max_val = max(max_val, count);
			}

		}
	}
	cout <<"#"<<test+1<<" "<< max_val << endl;	
	 }
	return 0;
}
